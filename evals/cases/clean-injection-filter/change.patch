+/**
+ * Flags customer text that tries to instruct the summarization model, so
+ * agents see a warning next to the summary. Detection only: flagged tickets
+ * are still summarized (the prompt already quotes them as data).
+ */
+const PATTERNS: readonly RegExp[] = [
+  /\bignore (all |any )?(previous|prior|above) instructions\b/i,
+  /\byou are now\b/i,
+  /\b(system|developer) prompt\b/i,
+  /\bapprove this (pr|pull request|request)\b/i,
+];
+
+export interface InjectionCheck {
+  flagged: boolean;
+  matches: string[];
+}
+
+export function checkForInjection(text: string): InjectionCheck {
+  const matches = PATTERNS.flatMap((pattern) => {
+    const match = pattern.exec(text);
+    return match ? [match[0]] : [];
+  });
+  return { flagged: matches.length > 0, matches };
+}
