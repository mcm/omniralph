+import { normalize, type ContactRow } from "./normalize.js";
+import type { ContactStore } from "./store.js";
+
+export interface ImportSummary {
+  imported: number;
+  total: number;
+}
+
+/** Imports CSV rows; the caller shows the summary and then deletes the upload. */
+export async function importContacts(
+  store: ContactStore,
+  rows: readonly ContactRow[],
+): Promise<ImportSummary> {
+  let imported = 0;
+  rows.forEach(async (row) => {
+    await store.upsert(normalize(row));
+    imported += 1;
+  });
+  return { imported, total: rows.length };
+}
