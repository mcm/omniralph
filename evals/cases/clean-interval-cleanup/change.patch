+import { useEffect, useState } from "react";
+import { fetchJobStatus, type JobStatus } from "../api.js";
+
+const POLL_INTERVAL_MS = 2_000;
+
+/** Polls a job's status while the component is mounted. */
+export function useJobStatus(jobId: string): JobStatus | null {
+  const [status, setStatus] = useState<JobStatus | null>(null);
+
+  useEffect(() => {
+    const controller = new AbortController();
+    const poll = () => {
+      fetchJobStatus(jobId, controller.signal)
+        .then(setStatus)
+        .catch((error) => {
+          if (!controller.signal.aborted) console.warn("Job status poll failed", error);
+        });
+    };
+    poll();
+    const handle = setInterval(poll, POLL_INTERVAL_MS);
+    return () => {
+      clearInterval(handle);
+      controller.abort();
+    };
+  }, [jobId]);
+
+  return status;
+}
