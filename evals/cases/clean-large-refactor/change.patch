+++ b/src/text/truncate.ts
@@ -0,0 +1,20 @@
+/** Shortens text to at most `max` characters, cutting at a word boundary when possible. */
+export function truncate(text: string, max: number, ellipsis = "…"): string {
+  if (max <= 0) return "";
+  if (text.length <= max) return text;
+  const room = Math.max(0, max - ellipsis.length);
+  const cut = text.slice(0, room);
+  const lastSpace = cut.lastIndexOf(" ");
+  const head = lastSpace > room * 0.6 ? cut.slice(0, lastSpace) : cut;
+  return `${head.trimEnd()}${ellipsis}`.slice(0, max);
+}
+
+/** Middle-truncates, e.g. long file paths: "src/…/index.ts". */
+export function truncateMiddle(text: string, max: number, ellipsis = "…"): string {
+  if (text.length <= max) return text;
+  if (max <= ellipsis.length) return ellipsis.slice(0, max);
+  const room = max - ellipsis.length;
+  const start = Math.ceil(room / 2);
+  const end = Math.floor(room / 2);
+  return `${text.slice(0, start)}${ellipsis}${end > 0 ? text.slice(-end) : ""}`;
+}
