diff --git a/src/text/case.ts b/src/text/case.ts
new file mode 100644
index 0000000..1e5879b
--- /dev/null
+++ b/src/text/case.ts
@@ -0,0 +1,28 @@
+function words(input: string): string[] {
+  return input
+    .replace(/([a-z0-9])([A-Z])/g, "$1 $2")
+    .replace(/([A-Z]+)([A-Z][a-z])/g, "$1 $2")
+    .split(/[^A-Za-z0-9]+/)
+    .filter(Boolean);
+}
+
+/** "user id" / "user_id" / "UserID" → "userId". */
+export function camelCase(input: string): string {
+  return words(input)
+    .map((w, i) => (i === 0 ? w.toLowerCase() : w[0]!.toUpperCase() + w.slice(1).toLowerCase()))
+    .join("");
+}
+
+/** "userId" → "user_id". */
+export function snakeCase(input: string): string {
+  return words(input)
+    .map((w) => w.toLowerCase())
+    .join("_");
+}
+
+/** "userId" → "User Id". */
+export function titleCase(input: string): string {
+  return words(input)
+    .map((w) => w[0]!.toUpperCase() + w.slice(1).toLowerCase())
+    .join(" ");
+}
diff --git a/src/text/plural.ts b/src/text/plural.ts
new file mode 100644
index 0000000..8e21216
--- /dev/null
+++ b/src/text/plural.ts
@@ -0,0 +1,20 @@
+const IRREGULAR: Readonly<Record<string, string>> = {
+  person: "people",
+  child: "children",
+  mouse: "mice",
+};
+
+/** English plural for simple nouns: "box" → "boxes", "city" → "cities". */
+export function pluralize(noun: string): string {
+  const lower = noun.toLowerCase();
+  const irregular = IRREGULAR[lower];
+  if (irregular) return noun[0] === noun[0]?.toUpperCase() ? irregular[0]!.toUpperCase() + irregular.slice(1) : irregular;
+  if (/[^aeiou]y$/i.test(noun)) return `${noun.slice(0, -1)}ies`;
+  if (/(s|x|z|ch|sh)$/i.test(noun)) return `${noun}es`;
+  return `${noun}s`;
+}
+
+/** "1 file", "3 files". */
+export function countLabel(count: number, noun: string): string {
+  return `${count} ${count === 1 ? noun : pluralize(noun)}`;
+}
