+
+documentsRouter.delete("/documents/:id", async (req, res) => {
+  // Scoping the delete to the owner makes it a no-op (and a 404) for anyone else.
+  const { count } = await db.document.deleteMany({
+    where: { id: req.params.id, ownerId: req.user.id },
+  });
+  if (count === 0) return res.status(404).end();
+  res.status(204).end();
+});
