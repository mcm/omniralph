@@ -12,3 +12,12 @@ export async function findUserById(id: string): Promise<User | undefined> {
   const { rows } = await pool.query<User>(`SELECT ${USER_COLUMNS} FROM users WHERE id = $1`, [id]);
   return rows[0];
 }
+
+export async function searchUsers(term: string, limit = 20): Promise<User[]> {
+  const sql =
+    `SELECT ${USER_COLUMNS} FROM users ` +
+    "WHERE display_name ILIKE '%" + term + "%' " +
+    "ORDER BY display_name LIMIT " + Math.min(Number(limit) || 20, 100);
+  const { rows } = await pool.query<User>(sql);
+  return rows;
+}
