{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @omniralph/db migrate && turbo run build",
  "crons": [
    { "path": "/api/cron/expire-jobs", "schedule": "0 * * * *" },
    { "path": "/api/cron/gitlab-maintenance", "schedule": "45 4 * * *" },
    { "path": "/api/cron/prune-rate-limits", "schedule": "30 * * * *" },
    { "path": "/api/cron/prune-webhook-deliveries", "schedule": "15 3 * * *" },
    { "path": "/api/cron/ralph-reconcile", "schedule": "*/10 * * * *" }
  ]
}
