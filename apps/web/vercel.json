{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "turbo run build",
  "git": { "deploymentEnabled": false },
  "crons": [
    { "path": "/api/cron/chat-run-events", "schedule": "* * * * *" },
    { "path": "/api/cron/discord-gateway", "schedule": "*/9 * * * *" },
    { "path": "/api/cron/expire-jobs", "schedule": "0 * * * *" },
    { "path": "/api/cron/gitlab-maintenance", "schedule": "45 4 * * *" },
    { "path": "/api/cron/prune-hidden-refs", "schedule": "40 3 * * *" },
    { "path": "/api/cron/prune-rate-limits", "schedule": "30 * * * *" },
    { "path": "/api/cron/prune-webhook-deliveries", "schedule": "15 3 * * *" },
    { "path": "/api/cron/ralph-reconcile", "schedule": "*/10 * * * *" }
  ]
}
