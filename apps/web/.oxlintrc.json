{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["typescript", "nextjs", "react", "import", "jsx-a11y"],
  "jsPlugins": [
    "./lint-rules/design-system.mjs",
    "./lint-rules/data-path.mjs",
    "./lint-rules/ralph-conversation.mjs"
  ],
  "ignorePatterns": ["out/**", "build/**"],
  "rules": {
    "nextjs/google-font-display": "warn",
    "nextjs/google-font-preconnect": "warn",
    "nextjs/next-script-for-ga": "warn",
    "nextjs/no-async-client-component": "warn",
    "nextjs/no-before-interactive-script-outside-document": "warn",
    "nextjs/no-css-tags": "warn",
    "nextjs/no-head-element": "warn",
    "nextjs/no-html-link-for-pages": "error",
    "nextjs/no-img-element": "warn",
    "nextjs/no-page-custom-font": "warn",
    "nextjs/no-styled-jsx-in-document": "warn",
    "nextjs/no-sync-scripts": "error",
    "nextjs/no-title-in-document-head": "warn",
    "nextjs/no-typos": "warn",
    "nextjs/no-unwanted-polyfillio": "warn",
    "nextjs/inline-script-id": "error",
    "nextjs/no-assign-module-variable": "error",
    "nextjs/no-document-import-in-page": "error",
    "nextjs/no-duplicate-head": "error",
    "nextjs/no-head-import-in-document": "error",
    "nextjs/no-script-component-in-head": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{js,jsx,mjs,ts,tsx,mts,cts}"],
      "rules": {
        "react/display-name": "error",
        "react/jsx-key": "error",
        "react/jsx-no-comment-textnodes": "error",
        "react/jsx-no-duplicate-props": "error",
        "react/jsx-no-target-blank": "off",
        "react/jsx-no-undef": "error",
        "react/no-children-prop": "error",
        "react/no-danger-with-children": "error",
        "react/no-direct-mutation-state": "error",
        "react/no-find-dom-node": "error",
        "react/no-is-mounted": "error",
        "react/no-render-return-value": "error",
        "react/no-string-refs": "error",
        "react/no-unescaped-entities": "error",
        "react/no-unknown-property": "off",
        "react/no-unsafe": "off",
        "react/react-in-jsx-scope": "off",
        "import/no-anonymous-default-export": "warn",
        "jsx-a11y/alt-text": [
          "warn",
          {
            "elements": ["img"],
            "img": ["Image"]
          }
        ],
        "jsx-a11y/aria-props": "warn",
        "jsx-a11y/aria-proptypes": "warn",
        "jsx-a11y/aria-unsupported-elements": "warn",
        "jsx-a11y/role-has-required-aria-props": "warn",
        "jsx-a11y/role-supports-aria-props": "warn",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn",
        "react/static-components": "error",
        "react/use-memo": "error",
        "react/preserve-manual-memoization": "error",
        "react/incompatible-library": "warn",
        "react/immutability": "error",
        "react/globals": "error",
        "react/refs": "error",
        "react/set-state-in-effect": "error",
        "react/error-boundaries": "error",
        "react/purity": "error",
        "react/set-state-in-render": "error",
        "react/unsupported-syntax": "warn"
      }
    },
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "ralph-conversation/no-direct-session-write": "error"
      }
    },
    {
      "files": ["src/lib/tracker/**", "src/lib/ralph/conversation.ts", "src/**/*.test.{ts,tsx}"],
      "rules": {
        "ralph-conversation/no-direct-session-write": "off"
      }
    },
    {
      "files": ["src/**/*.tsx"],
      "rules": {
        "design-system/no-raw-color": "error",
        "design-system/no-inline-layout-style": "error",
        "design-system/no-arbitrary-tailwind": "error"
      }
    },
    {
      "files": ["src/app/(app)/**/*.tsx"],
      "rules": {
        "design-system/no-bare-timestamp": "error"
      }
    },
    {
      "files": ["src/**/*.test.tsx"],
      "rules": {
        "design-system/no-raw-color": "off",
        "design-system/no-inline-layout-style": "off",
        "design-system/no-arbitrary-tailwind": "off",
        "design-system/no-bare-timestamp": "off"
      }
    },
    {
      "files": ["src/app/(app)/**/*.{ts,tsx}"],
      "rules": {
        "data-path/no-server-data": "error"
      }
    },
    {
      "files": ["src/app/(app)/layout.tsx"],
      "rules": {
        "data-path/no-server-data": "off"
      }
    },
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@omniralph/tracker/linear",
                  "@omniralph/tracker/linear/*",
                  "@linear/sdk",
                  "@linear/sdk/*",
                  "@/lib/tracker/linear/*",
                  "**/tracker/linear/*",
                  "./linear/*"
                ],
                "message": "Reach trackers through @/lib/tracker (TrackerGateway, trackerAdapter, trackerExtras): only the Linear adapter, its routes and lib/tracker/adapters.ts import Linear modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/(app)/**/*.tsx", "src/components/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "next/link",
                "message": "Use Link from @/components/link: it shows the pending navigation."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@omniralph/tracker/linear",
                  "@omniralph/tracker/linear/*",
                  "@linear/sdk",
                  "@linear/sdk/*",
                  "@/lib/tracker/linear/*",
                  "**/tracker/linear/*",
                  "./linear/*"
                ],
                "message": "Reach trackers through @/lib/tracker (TrackerGateway, trackerAdapter, trackerExtras): only the Linear adapter, its routes and lib/tracker/adapters.ts import Linear modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/components/link.tsx",
        "src/components/auth-shell.tsx",
        "src/**/*.test.tsx",
        "src/**/*.test.ts",
        "src/lib/tracker/adapters.ts",
        "src/lib/tracker/linear/**",
        "src/app/api/webhooks/linear/**",
        "src/app/api/integrations/linear/**",
        "src/app/api/ui/integrations/linear/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/lib/chat/**", "src/lib/ask/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@omniralph/tracker/linear",
                  "@omniralph/tracker/linear/*",
                  "@linear/sdk",
                  "@linear/sdk/*",
                  "@/lib/tracker/linear/*",
                  "**/tracker/linear/*",
                  "./linear/*"
                ],
                "message": "The chat and Ask reach work items only through WorkItemTracker (tests included): don't import Linear modules."
              }
            ]
          }
        ]
      }
    }
  ]
}
