{
  "name": "@omniralph/agent",
  "version": "0.7.0",
  "description": "Omniralph agent host daemon",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcm/omniralph.git",
    "directory": "apps/agent"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "omniralph-agent": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch --conditions=@omniralph/source src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "fastest-levenshtein": "^1.0.16",
    "picomatch": "^4.0.7",
    "pino": "^10.4.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@omniralph/engine": "workspace:*",
    "@omniralph/ralph": "workspace:*",
    "@omniralph/shared": "workspace:*",
    "@types/proper-lockfile": "^4.1.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
