{
  "name": "@omniralph/agent",
  "version": "2.3.1",
  "description": "Omniralph agent daemon",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcm/omniralph.git",
    "directory": "apps/agent"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "omniralph-agent": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && vite build --config ui/vite.config.ts",
    "dev": "tsx watch --conditions=@omniralph/source src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsrs --noEmit && tsrs --noEmit -p ui",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "ably": "^2.29.0",
    "fastest-levenshtein": "^1.0.16",
    "picomatch": "^4.0.7",
    "pino": "^10.4.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@omniralph/engine": "workspace:*",
    "@omniralph/ralph": "workspace:*",
    "@omniralph/shared": "workspace:*",
    "@omniralph/tasks": "workspace:*",
    "@omniralph/ui": "workspace:*",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.2"
  }
}
