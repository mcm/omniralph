{
  "name": "@iamthemcmaster/omniralph-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Omniralph agent host daemon",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "omniralph-agent": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --conditions=@omniralph/source src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@omniralph/engine": "workspace:*",
    "@omniralph/shared": "workspace:*",
    "@vercel/queue": "^0.7.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
