{
  "name": "@omniralph/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle ORM schema, migrations and typed queries",
  "type": "module",
  "exports": {
    ".": {
      "@omniralph/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./changes": {
      "@omniralph/source": "./src/changes.ts",
      "types": "./dist/changes.d.ts",
      "default": "./dist/changes.js"
    },
    "./testing": "./testing/index.ts"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@omniralph/shared": "workspace:*",
    "@omniralph/tasks": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@chat-adapter/state-pg": "4.41.1",
    "@opentelemetry/api": "1.9.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15"
  }
}
