{
  "name": "@omniralph/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Review core: diff parsing, budget planning, prompt assembly, Claude provider",
  "type": "module",
  "exports": {
    ".": {
      "@omniralph/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./summary": {
      "@omniralph/source": "./src/summary.ts",
      "types": "./dist/summary.d.ts",
      "default": "./dist/summary.js"
    },
    "./same-issue": {
      "@omniralph/source": "./src/sameIssue.ts",
      "types": "./dist/sameIssue.d.ts",
      "default": "./dist/sameIssue.js"
    },
    "./learn-rule": {
      "@omniralph/source": "./src/learnRule.ts",
      "types": "./dist/learnRule.d.ts",
      "default": "./dist/learnRule.js"
    },
    "./rules": {
      "@omniralph/source": "./src/ruleDedupe.ts",
      "types": "./dist/ruleDedupe.d.ts",
      "default": "./dist/ruleDedupe.js"
    },
    "./eval": {
      "@omniralph/source": "./src/eval/index.ts",
      "types": "./dist/eval/index.d.ts",
      "default": "./dist/eval/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -R src/rubric/universal.md src/rubric/languages dist/rubric/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@omniralph/shared": "workspace:*",
    "fastest-levenshtein": "^1.0.16",
    "picomatch": "^4.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@omniralph/tasks": "workspace:*",
    "@types/picomatch": "^4.0.3",
    "yaml": "^2.9.1"
  }
}
