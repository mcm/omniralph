{
  "name": "@omniralph/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Review core: diff parsing, budget planning, prompt assembly, Claude provider",
  "type": "module",
  "exports": {
    ".": {
      "@omniralph/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./summary": {
      "@omniralph/source": "./src/summary.ts",
      "types": "./dist/summary.d.ts",
      "default": "./dist/summary.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -R src/rubric/universal.md src/rubric/languages dist/rubric/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@omniralph/shared": "workspace:*",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  }
}
