{
  "name": "@omniralph/tracker",
  "version": "0.0.0",
  "private": true,
  "description": "Issue tracker gateway interface with neutral types, optional capabilities, the Linear adapter and in-memory fakes",
  "type": "module",
  "exports": {
    ".": {
      "@omniralph/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@omniralph/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./linear": {
      "@omniralph/source": "./src/linear/index.ts",
      "types": "./dist/linear/index.d.ts",
      "default": "./dist/linear/index.js"
    },
    "./linear/testing": {
      "@omniralph/source": "./src/linear/testing.ts",
      "types": "./dist/linear/testing.d.ts",
      "default": "./dist/linear/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@linear/sdk": "^97.0.0"
  },
  "devDependencies": {
    "msw": "^3.0.2"
  }
}
