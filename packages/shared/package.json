{
  "name": "@omniralph/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared zod schemas and types",
  "type": "module",
  "exports": {
    ".": {
      "@omniralph/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@omniralph/source": "./src/usage-fixture.ts",
      "types": "./dist/usage-fixture.d.ts",
      "default": "./dist/usage-fixture.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@omniralph/tasks": "workspace:*",
    "zod": "^4.6.5"
  }
}
