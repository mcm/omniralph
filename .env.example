# Omniralph environment variables.
# Copy to .env (or apps/web/.env.local) and fill in. Never commit real values.
# Every variable is described in docs/env.md (kept in sync by apps/web/src/env-docs.test.ts).

# ── Package registry (build-time only) ───────────────────────────────────────
# @iamthemcmaster/ui is a private package on the public npm registry.
# Local dev: ~/.npmrc is already authenticated, nothing to set.
# GitHub Actions: the NPM_TOKEN secret; ci.yml and deploy-web.yml write it to .npmrc
# before installing (Vercel doesn't build, so it needs no token).
# NPM_TOKEN=

# ── Runtime ──────────────────────────────────────────────────────────────────
# Set automatically by Next.js / the agent's process manager.
# NODE_ENV=development

# ── Database (packages/db) ───────────────────────────────────────────────────
# Neon via the Vercel Marketplace. The app uses the pooled URL; migrations
# (`pnpm --filter db migrate`) prefer the direct URL when it is set.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://user:password@host/db?sslmode=require

# ── Hot state (apps/web/src/lib/hot-state) ───────────────────────────────────
# Optional Upstash Redis over TCP (rediss://), caching what idle agents poll so
# Neon can suspend. Unset: everything reads Postgres directly.
# REDIS_URL=rediss://default:password@host:6379

# ── Secrets at rest ──────────────────────────────────────────────────────────
# 32-byte AES-256-GCM key for SCM and Linear credentials (base64 or hex): openssl rand -base64 32
# ENCRYPTION_KEY=

# ── Control panel URL ────────────────────────────────────────────────────────
# Public base URL; code hosts deliver webhooks to it (GitLab: <APP_URL>/api/webhooks/gitlab).
# On Vercel it defaults to https://$VERCEL_PROJECT_PRODUCTION_URL.
# APP_URL=https://omniralph.example.com

# ── @bot mention commands (apps/web/src/lib/mentions) ───────────────────────
# Handle people mention in PR/MR comments: @<handle> review [quick|standard|deep],
# @<handle> dismiss [reason], or a question in a finding's thread. On PRs/MRs ralph opened,
# @<handle> fix [text] (or any other request outside a finding's thread) goes to ralph.
# Default: omniralph.
# On GitLab, set it to the bot user's username (the access token's bot user) so the
# mention autocompletes. Comments by the bot itself (and other bot accounts) are ignored.
# BOT_HANDLE=omniralph

# ── Sign-in (Auth.js, apps/web) ──────────────────────────────────────────────
# Session/cookie secret: openssl rand -base64 32
# AUTH_SECRET=
# GitHub OAuth app (callback: <APP_URL>/api/auth/callback/github)
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# GitLab OAuth application, scope read_user (callback: <APP_URL>/api/auth/callback/gitlab)
# AUTH_GITLAB_ID=
# AUTH_GITLAB_SECRET=
# Self-managed GitLab base URL (default https://gitlab.com)
# AUTH_GITLAB_URL=https://gitlab.example.com
# Who may sign in: emails in these domains (comma-separated, exact match, no subdomains)
# plus emails with a pending invitation to an organization. Signed-in users create
# or join an organization; roles are per organization.
# ALLOWED_EMAIL_DOMAINS=mcmaster.io
# Local development only: 1 enables sign-in by email without OAuth (/sign-in/dev?email=…)
# for the fixture database (apps/web/scripts/fixtures). Ignored in production builds.
# OMNIRALPH_DEV_SIGNIN=1
# Local development only: 1 makes the settings pickers read a fixture Linear workspace
# instead of linear.app (fixtures:up sets it). Ignored in production builds.
# OMNIRALPH_FIXTURE_LINEAR=1

# ── GitHub App (packages/scm GitHubAdapter) ──────────────────────────────────
# Manifest and setup: docs/github-app.md. Permissions: pull requests read & write,
# contents read & write (ralph pushes; reviews only ever get read tokens), issues read & write
# (Issue comment event, @bot replies), actions read (ralph's CI fixes), metadata read.
# Setup URL (Repositories › Connect GitHub returns here): <APP_URL>/repositories/github/callback
# ("Redirect on update" on, so changing the installation's repositories also returns here).
# Keep "Request user authorization (OAuth) during installation" off: it disables the Setup URL,
# and the callback depends on it.
# Events: pull_request, issue_comment, pull_request_review_comment, workflow_run.
# GITHUB_APP_ID=
# App slug for the installation link (github.com/apps/<slug>); looked up via GET /app if unset.
# GITHUB_APP_SLUG=
# Webhook secret configured on the app (verifies X-Hub-Signature-256).
# GITHUB_WEBHOOK_SECRET=
# App JWT signing (docs/adr/0002-agent-auth.md). Preferred: the private key imported
# into an external-origin Vercel KMS issuer, so it never sits in an env var. The issuer
# must be RS256 (`vercel kms import <name> --key <pem> --algorithm RS256`); KMS defaults to RS512.
# GITHUB_APP_KMS_ISSUER_ID=
# Fallback / local dev: the PEM private key (PKCS#1 or PKCS#8; literal \n is accepted).
# GITHUB_APP_PRIVATE_KEY=
# GitHub Enterprise Server only: REST base URL (default https://api.github.com)
# GITHUB_API_URL=https://ghe.example.com/api/v3

# ── Linear app (ralph, apps/web/src/lib/linear) ─────────────────────────────
# Setup, routing and delegating issues: docs/linear.md.
# A Linear OAuth application, installed by an admin from Settings › Integrations
# (actor=app, scopes read,write,app:assignable,app:mentionable).
# Callback URL: <APP_URL>/api/integrations/linear/callback
# Webhook URL: <APP_URL>/api/webhooks/linear (Agent session events + Issues)
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# Webhook signing secret (verifies the Linear-Signature header).
# LINEAR_WEBHOOK_SECRET=

# ── Slack app (chat front door, apps/web/src/lib/chat) ─────────────────────
# One Slack app per deployment, created from docs/slack-app-manifest.yaml and
# installed by an admin from Settings › Integrations › Connect Slack.
# Redirect URL: <APP_URL>/api/integrations/slack/callback
# Event request URL: <APP_URL>/api/webhooks/slack
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Signing secret (verifies Slack's request signatures).
# SLACK_SIGNING_SECRET=

# ── Discord app (chat front door, apps/web/src/lib/chat) ───────────────────
# One Discord application per deployment, with a bot user; an admin adds the bot
# to a server from Settings › Integrations › Connect Discord.
# OAuth2 redirect: <APP_URL>/api/integrations/discord/callback
# Interactions endpoint URL: <APP_URL>/api/webhooks/discord
# Application ID (also the OAuth2 client ID).
# DISCORD_APPLICATION_ID=
# DISCORD_CLIENT_SECRET=
# Bot token, used for every connected server.
# DISCORD_BOT_TOKEN=
# Public key (verifies Discord's interaction signatures).
# DISCORD_PUBLIC_KEY=

# ── Chat assistant (control-panel agent, apps/web/src/lib/chat/agent) ───────
# Uses the Vercel AI Gateway. On Vercel it authenticates with the deployment's
# OIDC token; elsewhere set an AI Gateway API key. Without either, the bot says
# once per thread that the assistant isn't configured.
# AI_GATEWAY_API_KEY=
# AI Gateway model id (default anthropic/claude-haiku-5.5).
# CHAT_AGENT_MODEL=

# ── Agent tokens (apps/web/src/lib/agent-auth, docs/adr/0002-agent-auth.md) ──
# Vercel KMS issuer that signs agent access and job tokens (RS256, 15 minutes).
# One issuer per Vercel environment (production, preview, development). Tokens are
# verified against https://kms.vercel.com/<issuer>/jwks.json. Required in production.
# KMS_AGENT_ISSUER_ID=
# Local dev/tests only, used when KMS_AGENT_ISSUER_ID is unset: RSA private key PEM
# (PKCS#8 or PKCS#1; literal \n is accepted), e.g.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# Unset in dev/test → a key is generated in memory (tokens die on restart; agents refresh).
# The local signer refuses to run when VERCEL_ENV=production.
# LOCAL_AGENT_SIGNING_KEY=

# ── Job dispatch (apps/web/src/lib/dispatch, docs/adr/0001-job-dispatch.md) ──
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/* (apps/web/vercel.json).
# CRON_SECRET=
# Ably API key `<keyName>:<keySecret>` (publish + subscribe). When set, heartbeats hand
# harnesses a 12h subscribe-only token for wake-ups; unset means harnesses long-poll claims.
# ABLY_API_KEY=

# ── Harness host (apps/harness, not the control panel) ─────────────────────────
# Set in the harness's environment (systemd unit / shell), not on Vercel.
# Config file path (default ~/.config/omniralph/harness.json; written by `enroll`, mode 0600).
# OMNIRALPH_HARNESS_CONFIG=/home/omniralph/.config/omniralph/harness.json
# pino log level: trace, debug, info (default), warn, error.
# OMNIRALPH_LOG_LEVEL=info
# Claude auth: by default reviews use the host's logged-in `claude`. Optional overrides
# (check Anthropic's terms before using subscription auth for this tool):
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# Ralph needs no harness variables: no GH_TOKEN/GITLAB_TOKEN or Linear token (docs/deploy-harness.md).
# Self-update needs none either: pm2 is detected by pm_id, the agent package is public.
# Moving from cyralph: docs/cutover-from-cyralph.md maps its variables and config.json.
